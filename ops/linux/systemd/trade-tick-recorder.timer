# Dias úteis 19:05 de Brasília (como a tarefa TradeInitial-TickRecorder). Ligar: systemctl --user enable --now trade-tick-recorder.timer
[Unit]
Description=Gravador de ticks WIN/WDO (dias uteis 19:05 BRT)

[Timer]
OnCalendar=Mon..Fri 19:05 America/Sao_Paulo
Persistent=true

[Install]
WantedBy=timers.target
