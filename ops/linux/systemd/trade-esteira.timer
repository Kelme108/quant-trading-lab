# De hora em hora (como a tarefa TradeInitial-EsteiraCycle). O systemd nunca roda dois ciclos ao mesmo tempo.
# Ligar (decisão do dono, gasta dinheiro): systemctl --user enable --now trade-esteira.timer
[Unit]
Description=Esteira B3 (de hora em hora)

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
