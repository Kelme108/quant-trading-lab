# Liga o robô trade-demo@<nome> nos dias úteis às 08:40 de Brasília (como a tarefa TradeInitial-DemoB3 do Windows).
[Unit]
Description=Robo demo B3 %i (dias uteis 08:40 BRT)

[Timer]
OnCalendar=Mon..Fri 08:40 America/Sao_Paulo
Persistent=true
Unit=trade-demo@%i.service

[Install]
WantedBy=timers.target
