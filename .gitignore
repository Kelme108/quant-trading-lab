# Keep credentials, databases, caches, and generated results private by default.
user_data/*.json
!user_data/config.dryrun.json
user_data/*.sqlite
user_data/*.sqlite-journal
user_data/*.sqlite-shm
user_data/*.sqlite-wal
user_data/logs/
user_data/data/
user_data/backtest_results/*.json
reports/generated/
.env
.venv/
__pycache__/
.pytest_cache/
research/lab.sqlite
research/experiments/*/raw/

# Intermediate raw Freqtrade exports per cost scenario; the one artifact
# that matters is copied by lab/runner.py into research/experiments/<id>/raw/.
user_data/backtest_results/experiments/

# Scratch directory used ad hoc during manual validation; not part of the lab.
.claude-validation-tmp/

# Generated by `python -m lab.dashboard export`; regenerate instead of committing.
research/dashboard.html

# Live execution layer: runtime state and secrets stay out of git.
live/journal.sqlite*
live/STOP
live/config/live.json
live/config/live.sha256
live/.venv/
dashboard-files.txt
