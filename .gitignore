# Keep credentials, databases, caches, and generated results private by default.
user_data/*.json
!user_data/config.dryrun.json
user_data/*.sqlite
user_data/*.sqlite-journal
user_data/*.sqlite-shm
user_data/*.sqlite-wal
user_data/logs/
user_data/data/
user_data/backtest_results/*.json
reports/generated/
.env
.venv/
__pycache__/
.pytest_cache/
research/lab.sqlite
research/experiments/*/raw/

# Intermediate raw Freqtrade exports per cost scenario; the one artifact
# that matters is copied by lab/runner.py into research/experiments/<id>/raw/.
user_data/backtest_results/experiments/

# Scratch directory used ad hoc during manual validation; not part of the lab.
.claude-validation-tmp/

# Generated by `python -m lab.dashboard export`; regenerate instead of committing.
research/dashboard.html

# Live execution layer: runtime state and secrets stay out of git.
live/journal.sqlite*
live/STOP
live/config/live.json
live/config/live.sha256
live/.venv/
dashboard-files.txt
live/logs/
live/.env
live/journal*.sqlite*
ops/state/
ops/STOP
live/state/
research/b3/search/trades-A/
research/b3/search/trades-B/

live/STOP-live
# Instaladores baixados por ops/linux/downloads.sh (MT5 da Clear, MT5 normal, Python para Windows): nunca no git.
ops/linux/downloads/
live/commands/
live/.env.real

# Segredos e arquivos locais em qualquer pasta. Só os modelos .env.example vão para o Git.
.env.*
!.env.example
.claude/settings.local.json
Thumbs.db
.DS_Store

# Obsidian vault (docs/cerebro): keep only the shared settings, never per-user workspace state.
docs/cerebro/.obsidian/workspace*.json
docs/cerebro/.obsidian/cache
docs/cerebro/.obsidian/graph.json
docs/cerebro/.trash/
