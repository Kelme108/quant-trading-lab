# Copie para live/.env (ignorado pelo git) e preencha SÓ na sua máquina. NUNCA cole estes valores em chat, commit,
# nota ou log.
#
# Robôs da DEMO da Clear não usam senha: eles anexam ao terminal MetaTrader 5 que já está aberto e logado na conta
# demo (b3/config/broker_mt5.json). Este arquivo só é necessário para conectar por credenciais (por exemplo a sonda
# live/tools/probe_mt5.py) ou para a conta real, que está BLOQUEADA (allow_real=false; ver docs/cerebro/Regras-inviolaveis.md).
#
# Caminho do terminal MetaTrader 5 (terminal64.exe)
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Camada de segurança da conta real (deixe como está até o dono liberar por escrito)
LIVE_MODE=demo
LIVE_ACCOUNT_ID=
