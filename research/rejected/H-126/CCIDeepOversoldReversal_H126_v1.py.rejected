"""H-126: CCI(72) deep-oversold reversal on 15m, exit at the CCI zero line, 4.1% target, 1.5% stop, 12h time exit.

All times UTC, closed 15m bars only; a signal at the close of bar t fills at the open of bar t+1 (price E).
Spot, long only, one position per pair (engine), no pyramiding, no trailing stop.

Indicators (bar t included): CCI72 (talib CCI, timeperiod 72), RSI36 (talib RSI, timeperiod 36),
ATRp = ATR14 / close (talib ATR, timeperiod 14).
Entry at the close of bar t when all hold: CCI72 < -175; RSI36 < 90; ATRp >= 0.004; volume > 0;
fewer than 3 trades on the pair have an entry fill on the UTC calendar day of the fill bar (confirm_trade_entry).
Exits (custom_exit), first of:
- (a) stop-loss: native stoploss -0.015 (intrabar);
- (b) take-profit: price at or above E * 1.041;
- (c) mean reached: a closed bar k (opened at or after the entry fill) has CCI72(k) > 0 -> sold at the open of k+1;
- (d) time exit: 48 bars after the fill bar opened, i.e. 12 hours after the fill (the bar e+47 has closed).
"""

from __future__ import annotations

from datetime import timedelta

import numpy as np
import pandas as pd
from pandas import DataFrame

import talib.abstract as ta
from freqtrade.persistence import Trade
from freqtrade.strategy import IStrategy

BAR = timedelta(minutes=15)
CCI_PERIOD = 72
CCI_ENTRY_THRESHOLD = -175.0
CCI_EXIT_THRESHOLD = 0.0
RSI_PERIOD = 36
RSI_ENTRY_MAX = 90.0
ATR_PERIOD = 14
ATR_PCT_MIN = 0.004
MAX_ENTRIES_PER_UTC_DAY = 3
TAKE_PROFIT_PCT = 0.041
TIME_EXIT_BARS = 48
TIME_EXIT = TIME_EXIT_BARS * BAR


def utc_day(value) -> pd.Timestamp:
    """UTC calendar day of a timestamp (naive timestamps are taken as UTC)."""
    ts = pd.Timestamp(value)
    if ts.tzinfo is not None:
        ts = ts.tz_convert("UTC").tz_localize(None)
    return ts.floor("D")


class CCIDeepOversoldReversal_H126_v1(IStrategy):
    """Buy CCI72 < -175 in active markets; exit at the CCI zero line, +4.1%, -1.5% stop or 12 hours."""

    INTERFACE_VERSION = 3
    timeframe = "15m"
    can_short = False

    minimal_roi = {"0": 100.0}
    stoploss = -0.015
    use_exit_signal = True
    startup_candle_count = 500

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["cci"] = ta.CCI(dataframe, timeperiod=CCI_PERIOD)
        dataframe["rsi"] = ta.RSI(dataframe, timeperiod=RSI_PERIOD)
        dataframe["atr"] = ta.ATR(dataframe, timeperiod=ATR_PERIOD)
        dataframe["atr_pct"] = dataframe["atr"] / dataframe["close"]
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        cond = (
            dataframe["cci"].notna()
            & dataframe["rsi"].notna()
            & dataframe["atr_pct"].notna()
            & np.isfinite(dataframe["cci"].astype(float))
            & (dataframe["cci"] < CCI_ENTRY_THRESHOLD)
            & (dataframe["rsi"] < RSI_ENTRY_MAX)
            & (dataframe["atr_pct"] >= ATR_PCT_MIN)
            & (dataframe["volume"] > 0)
        ).fillna(False)
        if cond.any():
            dataframe.loc[cond, "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        # Every exit depends on the open trade (fill time, entry price): see custom_exit.
        return dataframe

    def confirm_trade_entry(self, pair, order_type, amount, rate, time_in_force, current_time,
                            entry_tag, side, **kwargs) -> bool:
        """Fewer than 3 entry fills on this pair on the UTC day of the fill bar (closed trades included)."""
        today = utc_day(current_time)
        count = 0
        for trade in Trade.get_trades_proxy(pair=pair):
            if utc_day(trade.open_date_utc) == today:
                count += 1
        return count < MAX_ENTRIES_PER_UTC_DAY

    def custom_exit(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        # (b) take-profit: +4.1% above the entry price E.
        if current_rate >= trade.open_rate * (1.0 + TAKE_PROFIT_PCT):
            return "take_profit_4_1pct"

        # (d) time exit: bars e..e+47 have closed, 12 hours after the fill.
        if current_time - trade.open_date_utc >= TIME_EXIT:
            return "time_exit_12h"

        # (c) mean reached: CCI72 > 0 at the close of a bar opened at or after the fill.
        dataframe, _ = self.dp.get_analyzed_dataframe(pair, self.timeframe)
        if dataframe is not None and len(dataframe) > 0:
            closed = dataframe.loc[
                (dataframe["date"] >= trade.open_date_utc) & (dataframe["date"] + BAR <= current_time)
            ]
            if not closed.empty:
                cci = closed["cci"].to_numpy(dtype=float)
                volume = closed["volume"].to_numpy(dtype=float)
                if bool(np.any((cci > CCI_EXIT_THRESHOLD) & (volume > 0))):
                    return "cci_mean_reached"
        return None
