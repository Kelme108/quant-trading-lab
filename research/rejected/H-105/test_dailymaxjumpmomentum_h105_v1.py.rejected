import importlib.util
import sys
import types
import unittest
from datetime import datetime, timedelta, timezone
from pathlib import Path

import numpy as np
import pandas as pd


# Keep the tests runnable without installing Freqtrade or TA-Lib on the host.
freqtrade = types.ModuleType("freqtrade")
strategy_module = types.ModuleType("freqtrade.strategy")
strategy_module.IStrategy = object
freqtrade.strategy = strategy_module
sys.modules.setdefault("freqtrade", freqtrade)
sys.modules.setdefault("freqtrade.strategy", strategy_module)

talib = types.ModuleType("talib")
talib_abstract = types.ModuleType("talib.abstract")
talib_abstract.SMA = lambda dataframe, timeperiod: dataframe["close"].rolling(timeperiod).mean()
talib_abstract.RSI = lambda dataframe, timeperiod: pd.Series(50.0, index=dataframe.index)
talib.abstract = talib_abstract
sys.modules.setdefault("talib", talib)
sys.modules.setdefault("talib.abstract", talib_abstract)


ROOT = Path(__file__).parents[1]


def load_strategy(filename: str, class_name: str):
    path = ROOT / "user_data" / "strategies" / filename
    spec = importlib.util.spec_from_file_location(class_name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return getattr(module, class_name)


Strategy = load_strategy("DailyMaxJumpMomentum_H105_v1.py", "DailyMaxJumpMomentum_H105_v1")


def make_prices(n: int, seed: int = 7) -> np.ndarray:
    """Upward drifting series with occasional multi-bar jumps, so the regime and breakout can fire."""
    rng = np.random.default_rng(seed)
    returns = rng.normal(0.0004, 0.003, n)
    for start in range(300, n, 37):
        returns[start : start + 4] += 0.012
    for start in range(320, n, 91):
        returns[start : start + 6] -= 0.008
    return 100.0 * np.exp(np.cumsum(returns))


def make_frame(prices, start="2024-01-01 00:00:00") -> pd.DataFrame:
    prices = np.asarray(prices, dtype=float)
    opens = np.concatenate([[prices[0]], prices[:-1]])
    return pd.DataFrame(
        {
            "date": pd.date_range(start, periods=len(prices), freq="1h", tz="UTC"),
            "open": opens,
            "high": np.maximum(opens, prices) * 1.002,
            "low": np.minimum(opens, prices) * 0.998,
            "close": prices,
            "volume": np.ones(len(prices)),
        }
    )


def run(strategy, frame):
    frame = strategy.populate_indicators(frame, {})
    frame = strategy.populate_entry_trend(frame, {})
    frame = strategy.populate_exit_trend(frame, {})
    return frame


class FakeTrade:
    def __init__(self, open_date):
        self.open_date_utc = open_date


class DailyMaxJumpMomentumH105Tests(unittest.TestCase):
    def test_class_constants(self) -> None:
        self.assertEqual(Strategy.INTERFACE_VERSION, 3)
        self.assertEqual(Strategy.timeframe, "1h")
        self.assertFalse(Strategy.can_short)
        self.assertEqual(Strategy.minimal_roi, {"0": 100.0})
        self.assertEqual(Strategy.stoploss, -0.02)
        self.assertGreaterEqual(Strategy.startup_candle_count, 400)
        self.assertEqual(
            Strategy().protections,
            [{"method": "CooldownPeriod", "stop_duration_candles": 6}],
        )

    def test_block_values_match_definition(self) -> None:
        prices = make_prices(500)
        frame = run(Strategy(), make_frame(prices))
        closes = pd.Series(prices, index=frame["date"])
        block_closes = closes[frame["date"].dt.hour.values % 2 == 1]
        r = block_closes / block_closes.shift(1) - 1
        j = r.rolling(30).max()
        median = j.shift(1).rolling(150).median()
        sma50 = block_closes.rolling(50).mean()
        hh10 = block_closes.shift(1).rolling(10).max()
        indexed = frame.set_index("date")
        odd = indexed[indexed["block_end"]]
        pd.testing.assert_series_equal(odd["block_j"], j, check_names=False, check_freq=False)
        pd.testing.assert_series_equal(odd["block_median_j"], median, check_names=False, check_freq=False)
        pd.testing.assert_series_equal(odd["block_sma50"], sma50, check_names=False, check_freq=False)
        pd.testing.assert_series_equal(odd["block_hh10"], hh10, check_names=False, check_freq=False)
        # Held value on the even bar after a block is the same as on the block close.
        self.assertEqual(indexed["block_close"].iloc[2], indexed["block_close"].iloc[1])
        self.assertTrue(bool(indexed["block_end"].iloc[1]))
        self.assertFalse(bool(indexed["block_end"].iloc[2]))

    def test_signals_fire_and_are_binary_at_block_closes(self) -> None:
        frame = run(Strategy(), make_frame(make_prices(1000)))
        self.assertGreater(int(frame["enter_long"].fillna(0).sum()), 0)
        self.assertGreater(int(frame["exit_long"].fillna(0).sum()), 0)
        for column in ("enter_long", "exit_long"):
            self.assertTrue(set(frame[column].dropna().unique().tolist()).issubset({1}))
        entries = frame[frame["enter_long"] == 1]
        # Signal on odd-hour bars only; the fill (next open) is between 00:00 and 16:00 UTC.
        self.assertTrue((entries["date"].dt.hour % 2 == 1).all())
        fill_hours = (entries["date"] + pd.Timedelta(hours=1)).dt.hour
        self.assertTrue(((fill_hours >= 0) & (fill_hours <= 16)).all())
        # Entry conditions hold on every entry bar.
        self.assertTrue((entries["block_j"] >= entries["block_median_j"]).all())
        self.assertTrue((entries["block_close"] > entries["block_sma50"]).all())
        self.assertTrue((entries["block_close"] > entries["block_hh10"]).all())

    def test_exit_signals(self) -> None:
        frame = run(Strategy(), make_frame(make_prices(1000)))
        exits = frame[frame["exit_long"] == 1]
        session = exits[exits["exit_tag"] == "session_exit_23"]
        self.assertGreater(len(session), 0)
        self.assertTrue((session["date"].dt.hour == 22).all())
        below = exits[exits["exit_tag"] == "below_sma20"]
        self.assertGreater(len(below), 0)
        self.assertTrue((below["date"].dt.hour % 2 == 1).all())
        self.assertTrue((below["block_close"] < below["block_sma20"]).all())

    def test_zero_volume_produces_no_signal(self) -> None:
        frame = make_frame(make_prices(1000))
        frame["volume"] = 0.0
        out = run(Strategy(), frame)
        self.assertEqual(int(out["enter_long"].fillna(0).sum()), 0)
        self.assertEqual(int(out["exit_long"].fillna(0).sum()), 0)

        # A single zero-volume candle removes only that candle's signals.
        base = run(Strategy(), make_frame(make_prices(1000)))
        index = int(base.index[base["enter_long"] == 1][0])
        frame = make_frame(make_prices(1000))
        frame.loc[index, "volume"] = 0.0
        out = run(Strategy(), frame)
        self.assertNotEqual(out.loc[index, "enter_long"], 1)

    def test_undefined_startup_values_produce_no_signal(self) -> None:
        strategy = Strategy()
        out = run(strategy, make_frame(100.0 + np.arange(380, dtype=float)))
        # 181 blocks (362 bars) are needed before the median exists; nothing before that.
        first = out["block_median_j"].first_valid_index()
        self.assertGreaterEqual(first, 361)
        self.assertEqual(int(out.iloc[:361]["enter_long"].fillna(0).sum()), 0)
        out = run(strategy, make_frame(make_prices(1000)))
        self.assertEqual(int(out.iloc[: strategy.startup_candle_count - 40]["enter_long"].fillna(0).sum()), 0)
        undefined = out["block_median_j"].isna() | out["block_sma50"].isna() | out["block_hh10"].isna()
        self.assertEqual(int(out.loc[undefined, "enter_long"].fillna(0).sum()), 0)

    def test_missing_bar_voids_block(self) -> None:
        frame = make_frame(make_prices(1000))
        dropped = frame.drop(index=[600]).reset_index(drop=True)  # bar at an even hour (600 % 2 == 0)
        out = run(Strategy(), dropped)
        row = out[out["date"] == frame.loc[601, "date"]].iloc[0]
        self.assertTrue(pd.isna(row["block_close"]))
        self.assertFalse(bool(row["block_end"]))

    def test_signal_does_not_change_when_future_candles_are_appended(self) -> None:
        prices = make_prices(1100)
        n = 900
        strategy = Strategy()
        short = run(strategy, make_frame(prices[:n]))
        long = run(strategy, make_frame(prices))
        columns = [
            "block_close", "block_r", "block_j", "block_median_j",
            "block_sma50", "block_sma20", "block_hh10", "block_end",
        ]
        pd.testing.assert_frame_equal(
            short.loc[: n - 1, columns].reset_index(drop=True),
            long.loc[: n - 1, columns].reset_index(drop=True),
            check_dtype=False,
        )
        for column in ("enter_long", "exit_long"):
            a = short[column].fillna(0).reset_index(drop=True)
            b = long.loc[: n - 1, column].fillna(0).reset_index(drop=True)
            pd.testing.assert_series_equal(a, b, check_dtype=False)

    def test_time_exit_after_12_hours(self) -> None:
        strategy = Strategy()
        opened = datetime(2024, 3, 1, 4, 0, tzinfo=timezone.utc)
        trade = FakeTrade(opened)
        self.assertIsNone(
            strategy.custom_exit("BTC/USDT", trade, opened + timedelta(hours=11), 100.0, 0.01)
        )
        self.assertEqual(
            strategy.custom_exit("BTC/USDT", trade, opened + timedelta(hours=12), 100.0, 0.01),
            "time_exit_12h",
        )
        self.assertEqual(
            strategy.custom_exit("BTC/USDT", trade, opened + timedelta(hours=30), 100.0, -0.01),
            "time_exit_12h",
        )

    def test_no_take_profit(self) -> None:
        strategy = Strategy()
        opened = datetime(2024, 3, 1, 4, 0, tzinfo=timezone.utc)
        self.assertIsNone(
            strategy.custom_exit("BTC/USDT", FakeTrade(opened), opened + timedelta(hours=2), 150.0, 0.5)
        )


if __name__ == "__main__":
    unittest.main()
