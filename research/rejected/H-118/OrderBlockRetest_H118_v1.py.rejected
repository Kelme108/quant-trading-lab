"""H-118: 15m bullish order-block retest after a structure-breaking displacement.

All times UTC, closed 15m bars only; a signal at the close of bar t fills at the open of bar t+1 (price E).
Spot, long only, one position per pair (engine), no pyramiding.

- ATR = Wilder ATR(14) of true range (alpha 1/14, seeded with the mean of the first 14 true ranges).
- DISPLACEMENT at bar D: close(D) > max high of D-16..D-1; range(D) >= 1.5 x ATR(D-1);
  (close-low)/(high-low) >= 0.7.
- ORDER BLOCK: most recent bar j in D-5..D-1 with close < open (none: D creates no setup and leaves any
  existing setup untouched). OL = low(j), OH = high(j), MT = (OH+OL)/2.
- SETUP: replaces any older setup, active on bars D+1..D+32, killed by the first bar with close < OL,
  consumed by the first bar meeting the entry conditions (whether or not an order fills).
- ENTRY signal at the close of bar t: low(t) <= MT, close(t) > OL, ATR(t)/close(t) >= 0.004.
  The entry tag records OL and HH = max high of bars D..t.
- Fill only if fewer than 4 trades were opened on the pair in the UTC day of the fill (confirm_trade_entry).
- STOP: sd = max(1 - 0.998 x OL / E, 0.01) frozen at the fill; stop price E x (1 - sd) (custom_stoploss).
  Native stoploss -0.10 is only a backstop.
- TAKE-PROFIT: td = max(HH / E - 1, 0.015) frozen at the fill; sold when the price reaches E x (1 + td)
  (custom_exit). Stop wins when both are touched in one bar (the stop triggers intrabar in the engine).
- TIME EXIT: 48 bars (12 hours) after the fill (custom_exit).
"""

from __future__ import annotations

from datetime import timedelta

import numpy as np
import pandas as pd
from pandas import DataFrame

from freqtrade.persistence import Trade
from freqtrade.strategy import IStrategy

ATR_PERIOD = 14
STRUCTURE_LOOKBACK = 16
RANGE_ATR_MULT = 1.5
CLOSE_LOCATION_MIN = 0.7
OB_SEARCH_BARS = 5
SETUP_ACTIVE_BARS = 32
ACTIVITY_ATR_PCT_MIN = 0.004
STOP_ZONE_BUFFER = 0.998
STOP_MIN_PCT = 0.01
TARGET_MIN_PCT = 0.015
TIME_EXIT_BARS = 48
MAX_ENTRIES_PER_DAY = 4
BAR = timedelta(minutes=15)
TAG_PREFIX = "obret"


def utc_day(value) -> pd.Timestamp:
    """UTC calendar day of a timestamp (naive timestamps are taken as UTC)."""
    ts = pd.Timestamp(value)
    if ts.tzinfo is not None:
        ts = ts.tz_convert("UTC").tz_localize(None)
    return ts.floor("D")


def parse_tag(tag):
    """(OL, HH) recorded in an entry tag, or None for a tag this strategy did not write."""
    if not isinstance(tag, str):
        return None
    parts = tag.split("|")
    if len(parts) != 3 or parts[0] != TAG_PREFIX:
        return None
    try:
        zone_low = float(parts[1])
        high_high = float(parts[2])
    except ValueError:
        return None
    if not (np.isfinite(zone_low) and np.isfinite(high_high)) or zone_low <= 0 or high_high <= 0:
        return None
    return zone_low, high_high


def wilder_atr(high: np.ndarray, low: np.ndarray, close: np.ndarray, period: int) -> np.ndarray:
    """Wilder ATR; seed = mean of the first `period` true ranges (bars 1..period), backward-looking."""
    n = len(close)
    atr = np.full(n, np.nan)
    if n <= period:
        return atr
    tr = np.full(n, np.nan)
    prev_close = close[:-1]
    tr[1:] = np.maximum.reduce(
        [high[1:] - low[1:], np.abs(high[1:] - prev_close), np.abs(low[1:] - prev_close)]
    )
    if not np.all(np.isfinite(tr[1 : period + 1])):
        return atr
    atr[period] = tr[1 : period + 1].mean()
    for i in range(period + 1, n):
        if np.isfinite(tr[i]) and np.isfinite(atr[i - 1]):
            atr[i] = (atr[i - 1] * (period - 1) + tr[i]) / period
    return atr


def order_block_signals(open_, high, low, close, volume, atr):
    """Run the setup state machine forward. Returns (signal, zone_low, run_high) arrays."""
    n = len(close)
    signal = np.zeros(n, dtype=bool)
    out_ol = np.full(n, np.nan)
    out_hh = np.full(n, np.nan)

    prior_high = pd.Series(high).shift(1).rolling(STRUCTURE_LOOKBACK).max().to_numpy()
    prev_atr = pd.Series(atr).shift(1).to_numpy()
    rng = high - low
    with np.errstate(invalid="ignore", divide="ignore"):
        location = (close - low) / rng
    displacement = (
        np.isfinite(prior_high)
        & np.isfinite(prev_atr)
        & np.isfinite(rng)
        & (rng > 0)
        & (close > prior_high)
        & (rng >= RANGE_ATR_MULT * prev_atr)
        & (location >= CLOSE_LOCATION_MIN)
    )
    bearish = close < open_

    active = False
    setup_d = -1
    zone_low = zone_high = run_high = np.nan
    for t in range(n):
        if active:
            if t > setup_d + SETUP_ACTIVE_BARS:
                active = False
            else:
                run_high = max(run_high, high[t]) if np.isfinite(high[t]) else run_high
                if close[t] < zone_low:
                    active = False
                else:
                    mean_threshold = (zone_high + zone_low) / 2.0
                    ok = (
                        np.isfinite(low[t])
                        and np.isfinite(close[t])
                        and np.isfinite(atr[t])
                        and volume[t] > 0
                        and low[t] <= mean_threshold
                        and close[t] > zone_low
                        and atr[t] / close[t] >= ACTIVITY_ATR_PCT_MIN
                    )
                    if ok:
                        signal[t] = True
                        out_ol[t] = zone_low
                        out_hh[t] = run_high
                        active = False
        if displacement[t]:
            for j in range(t - 1, t - OB_SEARCH_BARS - 1, -1):
                if j >= 0 and bearish[j]:
                    active = True
                    setup_d = t
                    zone_low = low[j]
                    zone_high = high[j]
                    run_high = high[t]
                    break
    return signal, out_ol, out_hh


class OrderBlockRetest_H118_v1(IStrategy):
    """Buy the wick into the mean threshold of a bullish order block; target the displacement high."""

    INTERFACE_VERSION = 3
    timeframe = "15m"
    can_short = False

    minimal_roi = {"0": 100.0}
    stoploss = -0.10
    use_custom_stoploss = True
    use_exit_signal = True
    startup_candle_count = 400

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        open_ = dataframe["open"].to_numpy(dtype=float)
        high = dataframe["high"].to_numpy(dtype=float)
        low = dataframe["low"].to_numpy(dtype=float)
        close = dataframe["close"].to_numpy(dtype=float)
        volume = dataframe["volume"].to_numpy(dtype=float)
        atr = wilder_atr(high, low, close, ATR_PERIOD)
        signal, zone_low, run_high = order_block_signals(open_, high, low, close, volume, atr)
        dataframe["atr"] = atr
        dataframe["ob_signal"] = signal.astype(int)
        dataframe["ob_low"] = zone_low
        dataframe["ob_high"] = run_high
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        cond = (
            (dataframe["ob_signal"] == 1)
            & dataframe["ob_low"].notna()
            & dataframe["ob_high"].notna()
            & dataframe["atr"].notna()
            & (dataframe["volume"] > 0)
        ).fillna(False)
        if cond.any():
            dataframe.loc[cond, "enter_long"] = 1
            rows = dataframe.loc[cond, ["ob_low", "ob_high"]]
            dataframe.loc[cond, "enter_tag"] = [
                f"{TAG_PREFIX}|{float(ol)!r}|{float(hh)!r}"
                for ol, hh in zip(rows["ob_low"], rows["ob_high"])
            ]
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        # Take-profit and time exit depend on the open trade: see custom_exit.
        return dataframe

    def confirm_trade_entry(self, pair, order_type, amount, rate, time_in_force, current_time,
                            entry_tag, side, **kwargs) -> bool:
        """Fewer than 4 trades opened on this pair in the UTC day of the fill."""
        if parse_tag(entry_tag) is None:
            return False
        today = utc_day(current_time)
        opened = 0
        for trade in Trade.get_trades_proxy(pair=pair):
            if utc_day(trade.open_date_utc) == today:
                opened += 1
        return opened < MAX_ENTRIES_PER_DAY

    def custom_stoploss(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        parsed = parse_tag(trade.enter_tag)
        if parsed is None or not trade.open_rate or not current_rate or current_rate <= 0:
            return None
        zone_low, _ = parsed
        entry = float(trade.open_rate)
        stop_distance = max(1.0 - STOP_ZONE_BUFFER * zone_low / entry, STOP_MIN_PCT)
        stop_price = entry * (1.0 - stop_distance)
        # Distance of the frozen stop price below the current rate (positive = below).
        return max(1.0 - stop_price / float(current_rate), 1e-6)

    def custom_exit(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        parsed = trade.enter_tag
        parsed = parse_tag(parsed)
        if parsed is not None and trade.open_rate:
            _, high_high = parsed
            entry = float(trade.open_rate)
            target_pct = max(high_high / entry - 1.0, TARGET_MIN_PCT)
            if current_rate is not None and current_rate / entry - 1.0 >= target_pct:
                return "take_profit"
        if current_time >= trade.open_date_utc + TIME_EXIT_BARS * BAR:
            return "time_exit_12h"
        return None
