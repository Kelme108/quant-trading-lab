"""H-120: 15m ADR exhaustion reversal - after a full ADR drop from the day high, buy the first up-reversal bar.

Chart 15m, closed bars only, all times UTC; a signal at the close of bar t fills at the open of bar t+1.
Long only, spot, one position per pair (engine), no pyramiding, no ROI table, no trailing.

Definitions (day d = the 96 bars whose open time falls in [00:00, 24:00) UTC):
- ADR(d) = mean of (max high - min low) of each of the 14 completed UTC days before day d (no data from day d).
  Undefined (no signal) until 14 completed days exist; a day whose first bar in the data is not the 00:00
  bar is incomplete and makes ADR undefined for the windows that contain it.
- DH(t), DL(t) = highest high / lowest low of day d from 00:00 up to and including t; O = open of the 00:00 bar.
EXHAUSTION at t: DH - DL >= ADR; min(low[t-4..t]) == DL; DL < O.
TRIGGER at t: close(t) > high(t-1) and close(t) > open(t).
ACTIVITY: ATR(14) (Wilder, TA-Lib) / close(t) >= 0.004.
TIME WINDOW: bar t opens 04:00..21:45 UTC inclusive.
ONE TRADE PER DAY: no earlier entry on the pair in the same UTC day (confirm_trade_entry).
TARGET M = (DH + DL) / 2 frozen at the signal bar; the signal is skipped if M < 1.01 * close(t).
The entry tag carries DH, DL and M ("adr|DH|DL|M").
STOP SP = min(0.997 * DL, 0.99 * E), E = fill price; fixed, set at entry (custom_stoploss, intrabar);
native stoploss -0.15 is an outer backstop only.
EXIT (custom_exit), first of: price reaches M; the stop SP; time exit 48 bars (12 h) after entry.
"""

from __future__ import annotations

from datetime import timedelta

import numpy as np
import pandas as pd
import talib.abstract as ta
from pandas import DataFrame

from freqtrade.persistence import Trade
from freqtrade.strategy import IStrategy

ADR_DAYS = 14
BARS_PER_DAY = 96
LOW_RECENCY_BARS = 5  # bars t-4..t
ATR_PERIOD = 14
ATR_OVER_CLOSE_MIN = 0.004
WINDOW_START_MINUTE = 4 * 60
WINDOW_END_MINUTE = 21 * 60 + 45
TARGET_FRACTION = 0.5
MIN_TARGET_DISTANCE = 0.01
STOP_BELOW_DAY_LOW = 0.997
MIN_STOP_DISTANCE = 0.01
TIME_EXIT_BARS = 48
BAR = timedelta(minutes=15)
TAG_PREFIX = "adr"


def utc_day(value) -> pd.Timestamp:
    """UTC calendar day of a timestamp (naive timestamps are taken as UTC)."""
    ts = pd.Timestamp(value)
    if ts.tzinfo is not None:
        ts = ts.tz_convert("UTC").tz_localize(None)
    return ts.floor("D")


def parse_tag(tag):
    """(DH, DL, M) recorded in an entry tag, or None for a tag this strategy did not write."""
    if not isinstance(tag, str):
        return None
    parts = tag.split("|")
    if len(parts) != 4 or parts[0] != TAG_PREFIX:
        return None
    try:
        values = tuple(float(part) for part in parts[1:])
    except ValueError:
        return None
    if not all(np.isfinite(v) and v > 0 for v in values):
        return None
    return values


def stop_price(day_low: float, entry_rate: float) -> float:
    """SP = min(0.997 * DL, 0.99 * E)."""
    return min(STOP_BELOW_DAY_LOW * day_low, (1.0 - MIN_STOP_DISTANCE) * entry_rate)


def adr_indicators(dataframe: DataFrame) -> DataFrame:
    """Add the day-range columns and the signal ingredients. Backward-looking only."""
    dates = pd.to_datetime(dataframe["date"], utc=True)
    day = dates.dt.floor("D")
    minute = (dates.dt.hour * 60 + dates.dt.minute).to_numpy()

    # A day is usable only if its 00:00 bar is in the data (the first day of a window may start mid-day).
    day_start_ok = (dates.groupby(day).transform("min") == day).to_numpy()

    day_high = dataframe["high"].groupby(day).cummax().where(day_start_ok)
    day_low = dataframe["low"].groupby(day).cummin().where(day_start_ok)
    day_open = dataframe["open"].groupby(day).transform("first").where(day_start_ok)

    # ADR(d): mean range of the 14 completed days before d, on a gap-free daily calendar.
    first_ok = pd.Series(day_start_ok, index=dataframe.index).groupby(day).first()
    daily_range = (
        dataframe["high"].groupby(day).max() - dataframe["low"].groupby(day).min()
    ).where(first_ok)
    daily_range.index = pd.DatetimeIndex(daily_range.index)
    calendar = pd.date_range(daily_range.index.min(), daily_range.index.max(), freq="D")
    daily_range = daily_range.reindex(calendar)
    adr = daily_range.rolling(ADR_DAYS).mean().shift(1)
    dataframe["adr"] = adr.reindex(pd.DatetimeIndex(day)).to_numpy(dtype=float)

    dataframe["day_high"] = day_high
    dataframe["day_low"] = day_low
    dataframe["day_open"] = day_open
    dataframe["minute_of_day"] = minute
    dataframe["low_5bar_min"] = dataframe["low"].rolling(LOW_RECENCY_BARS).min()
    dataframe["target"] = TARGET_FRACTION * (day_high + day_low)
    atr = ta.ATR(dataframe, timeperiod=ATR_PERIOD)
    dataframe["atr_over_close"] = atr / dataframe["close"]
    return dataframe


class ADRExhaustionReversal_H120_v1(IStrategy):
    """Buy the first up-reversal bar after a full ADR drop from the day high, target the day's mid-range."""

    INTERFACE_VERSION = 3
    timeframe = "15m"
    can_short = False

    minimal_roi = {"0": 100.0}
    stoploss = -0.15
    use_custom_stoploss = True
    use_exit_signal = True
    startup_candle_count = 1440

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        return adr_indicators(dataframe)

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        close = dataframe["close"]
        day_high = dataframe["day_high"]
        day_low = dataframe["day_low"]
        target = dataframe["target"]
        minute = dataframe["minute_of_day"]
        exhaustion = (
            (day_high - day_low >= dataframe["adr"])
            & (dataframe["low_5bar_min"] == day_low)
            & (day_low < dataframe["day_open"])
        )
        trigger = (close > dataframe["high"].shift(1)) & (close > dataframe["open"])
        cond = (
            dataframe["adr"].notna()
            & day_high.notna()
            & day_low.notna()
            & dataframe["day_open"].notna()
            & dataframe["low_5bar_min"].notna()
            & dataframe["atr_over_close"].notna()
            & target.notna()
            & exhaustion
            & trigger
            & (dataframe["atr_over_close"] >= ATR_OVER_CLOSE_MIN)
            & (minute >= WINDOW_START_MINUTE)
            & (minute <= WINDOW_END_MINUTE)
            & (target >= (1.0 + MIN_TARGET_DISTANCE) * close)
            & (dataframe["volume"] > 0)
        ).fillna(False)
        if cond.any():
            dataframe.loc[cond, "enter_long"] = 1
            dataframe.loc[cond, "enter_tag"] = [
                f"{TAG_PREFIX}|{float(h)!r}|{float(l)!r}|{float(m)!r}"
                for h, l, m in zip(day_high[cond], day_low[cond], target[cond])
            ]
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        # Target and time exit depend on the open trade: see custom_exit.
        return dataframe

    def confirm_trade_entry(self, pair, order_type, amount, rate, time_in_force, current_time,
                            entry_tag, side, **kwargs) -> bool:
        """At most one entry per pair per UTC day, counting trades that were already closed."""
        if parse_tag(entry_tag) is None:
            return False
        today = utc_day(current_time)
        for trade in Trade.get_trades_proxy(pair=pair):
            if utc_day(trade.open_date_utc) == today:
                return False
        return True

    def custom_stoploss(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        parsed = parse_tag(trade.enter_tag)
        if parsed is None or current_rate <= 0:
            return self.stoploss
        level = stop_price(parsed[1], trade.open_rate)
        if level >= current_rate:
            return -0.0001
        return max(level / current_rate - 1.0, self.stoploss)

    def custom_exit(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        parsed = parse_tag(trade.enter_tag)
        if parsed is not None and current_rate >= parsed[2]:
            return "target_mid_range"
        if current_time - trade.open_date_utc >= TIME_EXIT_BARS * BAR:
            return "time_exit_12h"
        return None
