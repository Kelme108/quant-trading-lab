"""H-112: 15m OBV leads price. Buy a fresh 48-hour OBV high while price sits within 1.5% below its 48-hour high.

Closed 15m bars only; a signal at the close of bar t fills at the open of bar t+1. Spot, long only,
one open position per pair (engine), whole balance.

Definitions (all backward-looking):
- OBV(i) = OBV(i-1) + volume(i) if close(i) > close(i-1); - volume(i) if close(i) < close(i-1); unchanged if equal.
- OBVMAX(t) / OBVMIN(t) = max / min of OBV over bars t-192..t-1 (current bar excluded).
- HH(t) = highest high of bars t-192..t-1 (current bar excluded).
- L10(t) = lowest low of bars t-9..t (10 bars including the signal bar).
- Filter: closed 1h bars (built from the 15m data, attached with merge_informative_pair so only the last
  completed 1h bar is visible): 1h close > EMA(50) of 1h closes.

Entry at the close of bar t when all hold: OBV(t) > OBVMAX(t); close < HH; close >= 0.985 * HH; close > open;
1h filter; 0.008 <= R/close <= 0.03 with R = close - L10(t); volume > 0. The engine adds: no open position,
cooldown of 16 bars (protections), fewer than 3 trades on the pair on the UTC day (confirm_trade_entry).
STOP = L10(t) and TARGET = close + 1.5 R are stored in the entry tag and never moved.

Exits:
- STOP: fixed price STOP via custom_stoploss (native stoploss -0.04 is only a backstop).
- TAKE-PROFIT: custom_exit when the gross return since the fill reaches (TARGET - fill) / fill.
  The stop wins when both are touched.
- EARLY EXIT: exit signal when OBV(t) < OBVMIN(t) at the close of a bar; sells at the next open.
- TIME EXIT: custom_exit 48 bars (12 h) after the entry bar opens.
"""

from __future__ import annotations

from datetime import timedelta

import numpy as np
import pandas as pd
from pandas import DataFrame

from freqtrade.persistence import Trade
from freqtrade.strategy import IStrategy, merge_informative_pair

BAR = timedelta(minutes=15)
OBV_WINDOW = 192
PRICE_HIGH_WINDOW = 192
NEAR_HIGH_FRACTION = 0.985
STOP_LOW_WINDOW = 10
MIN_RISK_FRACTION = 0.008
MAX_RISK_FRACTION = 0.03
TARGET_R_MULTIPLE = 1.5
EMA_PERIOD = 50
COOLDOWN_BARS = 16
MAX_ENTRIES_PER_UTC_DAY = 3
TIME_EXIT_BARS = 48
TAG_PREFIX = "obv_lead"


def utc_day(value) -> pd.Timestamp:
    """UTC calendar day of a timestamp (naive timestamps are taken as UTC)."""
    ts = pd.Timestamp(value)
    if ts.tzinfo is not None:
        ts = ts.tz_convert("UTC").tz_localize(None)
    return ts.floor("D")


def parse_tag(tag):
    """(STOP, TARGET) recorded in an entry tag, or None for a tag this strategy did not write."""
    if not isinstance(tag, str):
        return None
    parts = tag.split("|")
    if len(parts) != 3 or parts[0] != TAG_PREFIX:
        return None
    try:
        stop = float(parts[1])
        target = float(parts[2])
    except ValueError:
        return None
    if not (np.isfinite(stop) and np.isfinite(target)) or stop <= 0 or target <= stop:
        return None
    return stop, target


def obv_indicators(dataframe: DataFrame) -> DataFrame:
    """OBV, its previous-192-bar extremes, the 192-bar prior high and the 10-bar low."""
    close = dataframe["close"]
    direction = np.sign(close.diff()).fillna(0.0)
    obv = (direction * dataframe["volume"]).cumsum()
    dataframe["obv"] = obv
    # Windows end at t-1: the current bar is excluded by the one-candle shift.
    dataframe["obv_max"] = obv.rolling(OBV_WINDOW).max().shift(1)
    dataframe["obv_min"] = obv.rolling(OBV_WINDOW).min().shift(1)
    dataframe["hh"] = dataframe["high"].rolling(PRICE_HIGH_WINDOW).max().shift(1)
    # Lowest low of the 10 bars including the signal bar.
    dataframe["l10"] = dataframe["low"].rolling(STOP_LOW_WINDOW).min()
    return dataframe


def hourly_trend_filter(dataframe: DataFrame) -> DataFrame:
    """1h bars built from the 15m closes: trend_ok = 1h close > EMA(50) of 1h closes (NaN until defined)."""
    dates = pd.to_datetime(dataframe["date"], utc=True)
    hour = dates.dt.floor("h")
    hourly_close = dataframe["close"].groupby(hour.to_numpy()).last()
    ema = hourly_close.ewm(span=EMA_PERIOD, adjust=False).mean()
    ema.iloc[: EMA_PERIOD - 1] = np.nan
    trend_ok = (hourly_close > ema).astype(float).where(ema.notna())
    index = pd.DatetimeIndex(hourly_close.index)
    if index.tz is None:
        index = index.tz_localize("UTC")
    return DataFrame(
        {
            "date": index,
            "close": hourly_close.to_numpy(dtype=float),
            "ema50": ema.to_numpy(dtype=float),
            "trend_ok": trend_ok.to_numpy(dtype=float),
        }
    )


class OBVLeadBreakout_H112_v1(IStrategy):
    """Buy a fresh 48h OBV high while price is still within 1.5% under its 48h high."""

    INTERFACE_VERSION = 3
    timeframe = "15m"
    can_short = False

    minimal_roi = {"0": 100.0}
    stoploss = -0.04
    use_custom_stoploss = True
    use_exit_signal = True
    exit_profit_only = False
    startup_candle_count = 2000

    @property
    def protections(self):
        return [{"method": "CooldownPeriod", "stop_duration_candles": COOLDOWN_BARS}]

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe = obv_indicators(dataframe)
        hourly = hourly_trend_filter(dataframe)
        dataframe = merge_informative_pair(dataframe, hourly, self.timeframe, "1h", ffill=True)
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        close = dataframe["close"]
        risk = close - dataframe["l10"]
        risk_fraction = risk / close
        cond = (
            dataframe["obv"].notna()
            & dataframe["obv_max"].notna()
            & dataframe["hh"].notna()
            & dataframe["l10"].notna()
            & dataframe["trend_ok_1h"].notna()
            & close.notna()
            & (dataframe["obv"] > dataframe["obv_max"])
            & (close < dataframe["hh"])
            & (close >= NEAR_HIGH_FRACTION * dataframe["hh"])
            & (close > dataframe["open"])
            & (dataframe["trend_ok_1h"] == 1.0)
            & (risk_fraction >= MIN_RISK_FRACTION)
            & (risk_fraction <= MAX_RISK_FRACTION)
            & (dataframe["volume"] > 0)
        ).fillna(False)
        if cond.any():
            stop = dataframe["l10"]
            target = close + TARGET_R_MULTIPLE * risk
            dataframe.loc[cond, "enter_long"] = 1
            dataframe.loc[cond, "enter_tag"] = [
                f"{TAG_PREFIX}|{float(s)!r}|{float(t)!r}"
                for s, t in zip(stop[cond], target[cond])
            ]
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        # Early exit: OBV below its previous-192-bar minimum at the close of a bar; sells at the next open.
        cond = (
            dataframe["obv"].notna()
            & dataframe["obv_min"].notna()
            & (dataframe["obv"] < dataframe["obv_min"])
            & (dataframe["volume"] > 0)
        ).fillna(False)
        if cond.any():
            dataframe.loc[cond, "exit_long"] = 1
            dataframe.loc[cond, "exit_tag"] = "obv_below_48h_low"
        return dataframe

    def confirm_trade_entry(self, pair, order_type, amount, rate, time_in_force, current_time,
                            entry_tag, side, **kwargs) -> bool:
        """Fewer than 3 trades opened on this pair during the UTC day, counting closed trades."""
        if parse_tag(entry_tag) is None:
            return False
        today = utc_day(current_time)
        opened_today = 0
        for trade in Trade.get_trades_proxy(pair=pair):
            if utc_day(trade.open_date_utc) == today:
                opened_today += 1
        return opened_today < MAX_ENTRIES_PER_UTC_DAY

    def custom_stoploss(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        """Fixed stop price STOP = L10 at the signal bar (relative to the current rate, so it never moves)."""
        levels = parse_tag(trade.enter_tag)
        if levels is None:
            return None
        stop, _ = levels
        if not current_rate or current_rate <= stop:
            return None  # already through the stop: custom_exit closes the trade
        return -(1.0 - stop / current_rate)

    def custom_exit(self, pair, trade, current_time, current_rate, current_profit, **kwargs):
        levels = parse_tag(trade.enter_tag)
        if levels is not None and current_rate:
            stop, target = levels
            # Stop first: it wins when both levels are touched.
            if current_rate <= stop:
                return "stop_l10"
            target_return = target / trade.open_rate - 1.0
            if current_rate / trade.open_rate - 1.0 >= target_return:
                return "take_profit_1_5r"
        if pd.Timestamp(current_time) >= pd.Timestamp(trade.open_date_utc) + TIME_EXIT_BARS * BAR:
            return "time_exit_12h"
        return None
