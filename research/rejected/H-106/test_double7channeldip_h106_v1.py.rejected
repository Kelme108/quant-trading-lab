import importlib.util
import math
import sys
import types
import unittest
from datetime import datetime, timedelta, timezone
from pathlib import Path

import numpy as np
import pandas as pd


freqtrade = types.ModuleType("freqtrade")
strategy_module = types.ModuleType("freqtrade.strategy")
strategy_module.IStrategy = object
freqtrade.strategy = strategy_module
sys.modules.setdefault("freqtrade", freqtrade)
sys.modules.setdefault("freqtrade.strategy", strategy_module)

talib = types.ModuleType("talib")
talib_abstract = types.ModuleType("talib.abstract")
talib_abstract.SMA = lambda dataframe, timeperiod: dataframe["close"].rolling(timeperiod).mean()
talib_abstract.RSI = lambda dataframe, timeperiod: pd.Series(50.0, index=dataframe.index)
talib.abstract = talib_abstract
sys.modules.setdefault("talib", talib)
sys.modules.setdefault("talib.abstract", talib_abstract)


ROOT = Path(__file__).parents[1]


def load_strategy(filename: str, class_name: str):
    path = ROOT / "user_data" / "strategies" / filename
    spec = importlib.util.spec_from_file_location(class_name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return getattr(module, class_name)


Strategy = load_strategy("Double7ChannelDip_H106_v1.py", "Double7ChannelDip_H106_v1")


class FakeTrade:
    def __init__(self, open_date_utc):
        self.open_date_utc = open_date_utc


def make_frame(n: int, start="2024-01-01 00:00", volume=1.0) -> pd.DataFrame:
    idx = np.arange(n)
    close = 100.0 + 0.03 * idx + 2.0 * np.sin(2 * math.pi * idx / 37.0)
    dates = pd.date_range(start, periods=n, freq="1h", tz="UTC")
    return pd.DataFrame(
        {
            "date": dates,
            "open": close,
            "high": close * 1.001,
            "low": close * 0.999,
            "close": close,
            "volume": np.full(n, volume),
        }
    )


def run_all(frame: pd.DataFrame) -> pd.DataFrame:
    strategy = Strategy()
    frame = strategy.populate_indicators(frame, {})
    frame = strategy.populate_entry_trend(frame, {})
    frame = strategy.populate_exit_trend(frame, {})
    return frame


class Double7H106Tests(unittest.TestCase):
    def test_class_constants(self) -> None:
        self.assertEqual(Strategy.INTERFACE_VERSION, 3)
        self.assertEqual(Strategy.timeframe, "1h")
        self.assertFalse(Strategy.can_short)
        self.assertEqual(Strategy.minimal_roi, {"0": 100.0})
        self.assertEqual(Strategy.stoploss, -0.02)
        self.assertFalse(Strategy.trailing_stop)
        self.assertGreaterEqual(Strategy.startup_candle_count, 420)
        self.assertEqual(Strategy().protections, [])

    def test_block_indicators_match_manual_computation(self) -> None:
        frame = run_all(make_frame(800))
        odd = frame[frame["hour_utc"] % 2 == 1]
        closes = odd["close"].reset_index(drop=True)
        sma = closes.rolling(200).mean()
        low7 = closes.rolling(7).min()
        high7 = closes.rolling(7).max()
        pd.testing.assert_series_equal(
            odd["sma200b"].reset_index(drop=True), sma, check_names=False
        )
        pd.testing.assert_series_equal(
            odd["low7b"].reset_index(drop=True), low7, check_names=False
        )
        pd.testing.assert_series_equal(
            odd["high7b"].reset_index(drop=True), high7, check_names=False
        )
        even = frame[frame["hour_utc"] % 2 == 0]
        self.assertTrue(even[["sma200b", "low7b", "high7b"]].isna().all().all())

    def test_signals_are_binary_and_follow_rule(self) -> None:
        frame = run_all(make_frame(1500))
        for column in ("enter_long", "exit_long"):
            self.assertIn(column, frame)
            self.assertTrue(set(frame[column].dropna().unique().tolist()).issubset({1}))
        entries = frame[frame["enter_long"] == 1]
        self.assertGreater(len(entries), 0)
        for _, row in entries.iterrows():
            self.assertEqual(row["hour_utc"] % 2, 1)
            self.assertTrue(1 <= row["hour_utc"] <= 17)
            self.assertGreater(row["close"], row["sma200b"])
            self.assertLessEqual(row["close"], row["low7b"])
        exits = frame[frame["exit_long"] == 1]
        self.assertTrue((exits["hour_utc"] == 22).any())
        self.assertTrue(((exits["exit_tag"] == "block_close_at_high7")).any())
        for _, row in exits.iterrows():
            if row["exit_tag"] == "block_close_at_high7":
                self.assertEqual(row["hour_utc"] % 2, 1)
                self.assertGreaterEqual(row["close"], row["high7b"])
            else:
                self.assertEqual(row["hour_utc"], 22)

    def test_entry_outside_session_window_is_blocked(self) -> None:
        frame = run_all(make_frame(1500))
        late = frame[frame["hour_utc"].isin([19, 21, 23])]
        self.assertFalse((late["enter_long"] == 1).any())

    def test_zero_volume_gives_no_signal(self) -> None:
        frame = run_all(make_frame(1500, volume=0.0))
        self.assertNotIn(1, frame.get("enter_long", pd.Series(dtype=float)).dropna().tolist())
        self.assertNotIn(1, frame.get("exit_long", pd.Series(dtype=float)).dropna().tolist())

        base = run_all(make_frame(1500))
        zeroed = make_frame(1500)
        zero_rows = base.index[(base["enter_long"] == 1) | (base["exit_long"] == 1)]
        zeroed.loc[zero_rows, "volume"] = 0.0
        out = run_all(zeroed)
        self.assertFalse((out.loc[zero_rows, "enter_long"] == 1).any())
        self.assertFalse((out.loc[zero_rows, "exit_long"] == 1).any())

    def test_undefined_startup_values_give_no_signal(self) -> None:
        frame = run_all(make_frame(1500))
        startup = Strategy.startup_candle_count
        head = frame.iloc[:startup]
        self.assertFalse((head["enter_long"] == 1).any())
        # No SMA200b before 200 complete blocks exist.
        self.assertTrue(frame.iloc[:399]["sma200b"].isna().all())

    def test_missing_candle_invalidates_block(self) -> None:
        frame = make_frame(1500)
        full = run_all(frame.copy())
        gap = frame.drop(index=500).reset_index(drop=True)  # remove a candle
        out = run_all(gap)
        # Rolling windows that include the broken block are undefined.
        self.assertTrue(out["sma200b"].notna().sum() < full["sma200b"].notna().sum())

    def test_no_lookahead(self) -> None:
        n, k = 1000, 300
        short = run_all(make_frame(n))
        long = run_all(make_frame(n + k))
        cols = ["sma200b", "low7b", "high7b", "block_close"]
        pd.testing.assert_frame_equal(
            short[cols], long.loc[: n - 1, cols], check_dtype=False
        )
        for column in ("enter_long", "exit_long"):
            a = short[column].fillna(0)
            b = long.loc[: n - 1, column].fillna(0)
            self.assertTrue((a.values == b.values).all())

    def test_time_exit_after_12_hours(self) -> None:
        strategy = Strategy()
        opened = datetime(2024, 1, 1, 3, 0, tzinfo=timezone.utc)
        trade = FakeTrade(opened)
        self.assertIsNone(
            strategy.custom_exit("BTC/USDT", trade, opened + timedelta(hours=11), 100.0, 0.0)
        )
        self.assertEqual(
            strategy.custom_exit("BTC/USDT", trade, opened + timedelta(hours=12), 100.0, 0.0),
            "time_exit_12h",
        )

    def test_clock_exit_at_23_utc(self) -> None:
        strategy = Strategy()
        opened = datetime(2024, 1, 1, 18, 0, tzinfo=timezone.utc)
        trade = FakeTrade(opened)
        self.assertIsNone(
            strategy.custom_exit(
                "BTC/USDT", trade, datetime(2024, 1, 1, 22, 0, tzinfo=timezone.utc), 100.0, 0.0
            )
        )
        self.assertIsNotNone(
            strategy.custom_exit(
                "BTC/USDT", trade, datetime(2024, 1, 1, 23, 0, tzinfo=timezone.utc), 100.0, 0.0
            )
        )


if __name__ == "__main__":
    unittest.main()
